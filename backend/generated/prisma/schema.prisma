// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id      Int    @id @default(autoincrement())
  name    String
  x_coord Float
  y_coord Float
}

model GameSession {
  id         Int       @id @default(autoincrement())
  sessionId  String    @unique
  startTime  DateTime
  endTime    DateTime?
  playerName String?
}
