// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Character {
  id      Int    @id @default(autoincrement())
  name    String
  x_coord Float
  y_coord Float
  image   String
}

model Score {
  id   Int    @id @default(autoincrement())
  name String
  time Int
}
